APP_NAME="Gadaikan API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Development default: SQLite. Ganti ke mysql bila tersedia.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gadaikan
# DB_USERNAME=gadaikan_dev
# DB_PASSWORD=develop_only

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Kredensial akun demo. JANGAN isi dengan kredensial produksi.
DEMO_ADMIN_EMAIL=admin.demo@gadaikan.test
DEMO_ADMIN_PHONE=081200000000
DEMO_ADMIN_PASSWORD=demo1234
DEMO_CUSTOMER_EMAIL=pelanggan.demo@gadaikan.test
DEMO_CUSTOMER_PHONE=081234567890
DEMO_CUSTOMER_PASSWORD=demo1234
